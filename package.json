{
  "name": "gistda-sphere-react",
  "version": "1.4.0",
  "description": "React wrapper library for GISTDA Sphere Map API with TypeScript support",
  "keywords": [
    "gistda",
    "sphere",
    "map",
    "maplibre",
    "react",
    "typescript",
    "thailand",
    "gis"
  ],
  "homepage": "https://github.com/dulapahv/gistda-sphere-react",
  "bugs": {
    "url": "https://github.com/dulapahv/gistda-sphere-react/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dulapahv/gistda-sphere-react.git"
  },
  "license": "MIT",
  "author": "dulapahv",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "dev:docs": "pnpm --parallel --filter gistda-sphere-react --filter docs run dev",
    "lint": "pnpm dlx ultracite check",
    "lint:fix": "pnpm dlx ultracite fix",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build",
    "test": "vitest --watch=false",
    "test:coverage": "vitest run --watch=false --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.5.15",
    "@commitlint/config-conventional": "^21.2.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "ultracite": "^8.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "packageManager": "pnpm@10.34.7+sha512.ba98abc585539933375b5971f4bc6d6c73a1b4b7edc4a879e7d102fe5423d1e02309d67c60a11f04955093a96e521ad9c3b138cdd654ca5be563f378b3ae48bd"
}

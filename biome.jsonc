{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/next"],
  "overrides": [
    {
      // Vitest 4 requires `function` (not arrow) for constructor mocks called with `new`
      "includes": ["src/__tests__/**"],
      "linter": {
        "rules": {
          "complexity": {
            "useArrowFunction": "off"
          }
        }
      }
    },
    {
      // Inline handlers are idiomatic in the self-contained docs demos; the
      // rerender cost is irrelevant for these and useCallback would obscure them
      "includes": ["docs/**"],
      "linter": {
        "rules": {
          "performance": {
            "noJsxPropsBind": "off"
          }
        }
      }
    }
  ],
  "linter": {
    "rules": {
      "style": {
        // PascalCase is standard for React components
        "useFilenamingConvention": "off"
      },
      "complexity": {
        // Allow higher complexity for complex map component setup logic
        "noExcessiveCognitiveComplexity": {
          "level": "warn",
          "options": {
            "maxAllowedComplexity": 65
          }
        },
        // forEach is acceptable in test setup
        "noForEach": "warn",
        // Banned types are needed for mock setup
        "noBannedTypes": "off"
      },
      "performance": {
        // Barrel files are standard for library exports
        "noBarrelFile": "off"
      },
      "suspicious": {
        // Array index keys are acceptable when items are not reordered
        "noArrayIndexKey": "warn",
        // Type-aware, and both its assumptions are wrong here: it narrows
        // useRef().current to its initial null (the refs are assigned in other
        // effects), and it trusts our hand-written declarations of the external
        // `sphere` global, whose submodules may be absent at runtime. Applying
        // it would delete live code and real guards, so it stays advisory.
        "noUnnecessaryConditions": "warn",
        // Iterator callback return is acceptable in test setup
        "useIterableCallbackReturn": "warn"
      }
    }
  }
}
